# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ACCESS_TOKEN=

# --- Appwrite (зеркало GAL на Appwrite Functions) ---
# Ключ создаётся на главной странице проекта Appwrite и хранится только в .env.local.
APPWRITE_ENDPOINT=https://aw2.ravva.su/v1
APPWRITE_PROJECT_ID=6b019993003c1f1df715
APPWRITE_API_KEY=

# --- App ---
# APP_ENV=development
# APP_URL=https://gal-inky.vercel.app
# SUPABASE_TIMEOUT_SECONDS=6
# DISPLAY_UTC_OFFSET_HOURS=3

# --- Вложения к прохождению достижения ---
# Суммарный лимит файлов одной заявки на прохождение (16 МБ) и максимум файлов.
# На Vercel тело запроса обрезается примерно на 4.5 МБ — для этого деплоя
# поставьте MAX_ATTACHMENT_BYTES=4194304, иначе крупная загрузка отбросится
# платформой до FastAPI. На self-hosted Appwrite Functions ограничения 4.5 МБ нет.
# MAX_ATTACHMENT_BYTES=16777216
# MAX_FILES_PER_COMPLETION=10
# MAX_COMMENT_LENGTH=2000

# --- Bradley–Terry bootstrap ---
# BT_BOOTSTRAP_REPLICATES=200
# BT_BOOTSTRAP_SEED=20260101

# --- LTHub OAuth (public PKCE client, без client_secret) ---
# LTHUB_OAUTH_ENABLED=true
# LTHUB_CLIENT_ID=gal
# LTHUB_AUTHORIZE_URL=https://lthub.vercel.app/oauth/authorize
# LTHUB_TOKEN_URL=https://lthub.vercel.app/oauth/token
# LTHUB_USERINFO_URL=https://lthub.vercel.app/oauth/userinfo
# LTHUB_REDIRECT_URI=

# --- API LTHub: проверка пароля LTHub-аккаунта в GAL ---
# LTHUB_API_BASE_URL=https://lthub.vercel.app
# LTHUB_LOGIN_URL=
# LTHUB_PASSWORD_CHECK_ENABLED=true
# LTHUB_REQUEST_TIMEOUT_SECONDS=6

# --- OAuth-провайдер GAL для LTHub ---
# OAUTH_PROVIDER_ENABLED=true
# OAUTH_LTHUB_CLIENT_ID=lthub
# Дополнительные redirect_uri через запятую (базовые уже в коде).
# OAUTH_LTHUB_REDIRECT_URIS=https://lthub.vercel.app/api/auth/gal/callback