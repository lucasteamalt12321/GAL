# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ACCESS_TOKEN=

# --- App ---
# APP_ENV=development
# APP_URL=https://gal-inky.vercel.app
# SUPABASE_TIMEOUT_SECONDS=6
# DISPLAY_UTC_OFFSET_HOURS=3

# --- Bradley–Terry bootstrap ---
# BT_BOOTSTRAP_REPLICATES=200
# BT_BOOTSTRAP_SEED=20260101

# --- LTHub OAuth (public PKCE client, без client_secret) ---
# LTHUB_OAUTH_ENABLED=true
# LTHUB_CLIENT_ID=gal
# LTHUB_AUTHORIZE_URL=https://lthub.vercel.app/oauth/authorize
# LTHUB_TOKEN_URL=https://lthub.vercel.app/oauth/token
# LTHUB_USERINFO_URL=https://lthub.vercel.app/oauth/userinfo
# LTHUB_REDIRECT_URI=

# --- OAuth-провайдер GAL для LTHub ---
# OAUTH_PROVIDER_ENABLED=true
# OAUTH_LTHUB_CLIENT_ID=lthub
# Дополнительные redirect_uri через запятую (базовые уже в коде).
# OAUTH_LTHUB_REDIRECT_URIS=https://lthub.vercel.app/api/auth/gal/callback